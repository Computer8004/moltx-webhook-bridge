{
  "name": "@moltx/webhook-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev:server": "bun run --filter @moltx/bridge-server dev",
    "dev:client": "bun run --filter @moltx/bridge-client dev",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.0"
}
