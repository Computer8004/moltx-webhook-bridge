{
  "name": "@moltx/webhook-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @moltx/bridge-server dev",
    "dev:client": "pnpm --filter @moltx/bridge-client dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.0"
}