# Moltx Webhook Bridge Server Configuration

# Server port
PORT=8080

# Public URL (for generating webhook URLs)
PUBLIC_URL=https://bridge.moltx.io

# Database path (SQLite)
DATABASE_URL=./data/bridge.db

# Moltx→Bridge authentication
# Set this to a secure random string and share with Moltx
MOLTX_API_KEY=your-secure-random-key-here

# x402 payment configuration
X402_RECIPIENT=0xYourWalletAddress
X402_AMOUNT=0.01
X402_NETWORK=base
